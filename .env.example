# =============================================================================
# Consolidated env example for the migrated stack (Next.js app + Node worker).
# Real values live in Railway. Per-tenant secrets (whatsapp_token,
# whatsapp_app_secret, webhook_secret, app_url) live in the companies table.
#
# Dropped vs. old layout:
#   WHATSAPP_PHONE_ID  — per-company in DB (companies.whatsapp_phone_number_id)
#   WEBHOOK_SECRET     — per-company in DB (companies.webhook_secret)
# =============================================================================

# ── Shared (app + worker) ────────────────────────────────────────────────────

# Supabase Postgres connection string.
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# OpenRouter routes ALL LLM calls — chat (bot + dashboard helpers), the
# statistics summary, and voice transcription. No direct OpenAI key needed.
# Account must have credit loaded (a key with $0 balance fails).
OPENROUTER_API_KEY=sk-or-...
# Chat model, OpenRouter-namespaced.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Transcription model. Must accept AUDIO input (gpt-4o-mini cannot) — Gemini
# Flash is the default; strong on Arabic.
OPENROUTER_TRANSCRIBE_MODEL=google/gemini-2.5-flash

# Runtime mode.
NODE_ENV=development
LOG_LEVEL=info

# Server binding. Railway injects PORT.
PORT=3000
HOST=0.0.0.0

# ── App only ─────────────────────────────────────────────────────────────────

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_secret

# Brevo (transactional email).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=WAK Solutions
# Fallback recipient when no admin email is found in the agents table.
MANAGER_EMAIL=manager@yourdomain.com

# Daily.co (video rooms for meetings).
DAILY_API_KEY=

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# WebAuthn (biometric login).
# RP_ID = the domain without protocol, e.g. wak-agent.up.railway.app
# RP_ORIGIN = full origin, e.g. https://wak-agent.up.railway.app
RP_ID=
RP_ORIGIN=

# Absolute base URL the app uses for outbound links in emails and password
# reset flows. Railway-injected RAILWAY_PUBLIC_URL / RAILWAY_PUBLIC_DOMAIN are
# read as fallbacks.
APP_URL=https://wak-agent.up.railway.app

# First-deploy admin seed. Only used by scripts/seed-admin.ts on a fresh DB —
# has no effect once any row exists in the agents table.
SEED_ADMIN_EMAIL=admin@yourdomain.com
DASHBOARD_PASSWORD=change_me_immediately

# ── Worker only ──────────────────────────────────────────────────────────────

# Meta webhook GET handshake token. Must be >=32 chars; refuses to start
# without it. Single global value — Meta's webhook registration is per-App,
# not per-phone-number, so per-tenant verify tokens are not feasible.
VERIFY_TOKEN=

# Base URL the worker uses to construct customer-facing booking links when
# companies.app_url is unset for a tenant.
DASHBOARD_URL=https://wak-agent.up.railway.app

# Gupshup inbound webhook auth. Gupshup does NOT sign payloads (unlike Meta's
# HMAC), so this is the shared token we configure on the Gupshup callback
# (sent back as the `apikey` header) and compare constant-time. If unset the
# /gupshup route accepts unauthenticated (bring-up only) — set this AND
# IP-allowlist Gupshup before production. Per-tenant Gupshup send creds
# (api key, app name, source number) live in the companies table.
GUPSHUP_WEBHOOK_TOKEN=

# WhatsApp "start a chat" (Contacts → Start chat). WhatsApp blocks free-form
# first contact: the agent-initiated opening message MUST be a Meta-approved
# template. Leave blank until you've created + had a template approved in Meta
# Business Manager — until then, Start chat returns a clear "no template yet"
# error and customers must message first. Name + language must match exactly.
WHATSAPP_INITIAL_TEMPLATE=
WHATSAPP_INITIAL_TEMPLATE_LANG=en

# =============================================================================
# Emergency admin reactivation
#   If an admin is accidentally deactivated and locked out, run in Supabase:
#     UPDATE agents SET is_active = true WHERE email = 'admin@example.com';
#     DELETE FROM session WHERE sess->>'agentId' = '<agent_id>'::text;
#   Deactivating an agent immediately purges their sessions (instant lockout).
# =============================================================================
